class DropBoxGame {

    field PlayerBlock player;
    field Array squares;   // up to 5 falling squares at once
    field int score;
    field int spawnTimer;  // counts frames, spawn when it reaches 67 (2 seconds at 30 ms/frame)

    // Constructor - playerWidth is the width chosen on the start screen (15-50)
    constructor DropBoxGame new(int playerWidth) {
        var int i;
        var int playerX;
        // Center the player horizontally: screen is 512 wide
        let playerX = 256 - (playerWidth / 2);
        let player = PlayerBlock.new(playerX, 240, playerWidth, 10);
        let squares = Array.new(5);
        let i = 0;
        while (i < 5) {
            let squares[i] = null;
            let i = i + 1;
        }
        let score = 0;
        let spawnTimer = 67; // spawn on the very first frame
        return this;
    }

    // Helper method to Spawn a square in the first free slot, do nothing if all slots are full
    method void spawnSquare(int speed) {
        var int i;
        var int randomInt;
        let i = 0;
        while (i < 5) {
            if (squares[i] = null) {
                do Random.setSeed(player.getX() * 2 + player.getY() * 3 + score); // random seed
                let randomInt = Random.randRange(501); // 512 - 10 (max square size) - 1 (to stay within bounds)
                let squares[i] = FallingSquare.new(randomInt, 10, speed);
                return;
            }
            let i = i + 1;
        }
        return;
    }

    // Main game loop 
    method void run() {
        var int k;
        var int i;
        var int speed;
        var FallingSquare sq;

        // Main loop 
        while (true) {

            // Handle keyboard input (a = left, d = right) 
            let k = Keyboard.keyPressed();
            if (~(k = 0)) {
                // a 
                if (k = 97) {
                    do player.moveLeft();
                }
                // d
                if (k = 100) {
                    do player.moveRight();
                }
            }

            // Spawn a new square every 2 seconds (67 frames at 30 ms each)
            let spawnTimer = spawnTimer + 1;
            if (spawnTimer > 66) {
                let spawnTimer = 0;
                // speed increases with score: starts at 2, gains 1 every 2 catches w/ int division
                let speed = 2 + (score / 2);
                do spawnSquare(speed);
            }

            // Update every active square
            let i = 0;
            while (i < 5) {
                let sq = squares[i];
                if (~(sq = null)) {
                    do sq.moveDown();

                    // Caught by player
                    if (collides(sq)) {
                        do sq.erase();
                        do player.draw(); // redraw player because the square overlap erases it
                        let squares[i] = null;
                        let score = score + 1;
                        do Output.moveCursor(0, 0);
                        do Output.printString("Score: ");
                        do Output.printInt(score);
                    } else {
                        // Missed - reached bottom without being caught -> player lose
                        if (sq.isAtBottom()) {
                            do sq.erase();
                            do drawGameOver();
                            return;
                        }
                    }
                }
                let i = i + 1;
            }

            // Each frame is 30 ms
            do Sys.wait(30);
        }
        return;
    }

    // check if rectangles intersect 
    method boolean collides(FallingSquare square) {
        // check if square and player overlap in x and y
        if ((square.getX() + square.getSize()) > player.getX()) {
            if (square.getX() < (player.getX() + player.getWidth())) {
                if ((square.getY() + square.getSize()) > player.getY()) {
                    if (square.getY() < (player.getY() + player.getHeight())) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    //  Run when end game
    method void drawGameOver() {
        // black out screen
        do Screen.setColor(true);
        do Screen.drawRectangle(0, 0, 511, 255);

        // draw "Game Over" text in white in the top left
        do Screen.setColor(false);
        do Output.moveCursor(0, 0);
        do Output.printString("You missed! Game Over :( Final Score: ");
        do Output.printInt(score);

        // infinite loop 
        while (true) {
            do Sys.wait(20000);
        }
        return;
    }

}