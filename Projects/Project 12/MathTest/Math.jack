/**
 *  A library of commonly used mathematical functions.
 *  All functions runs in O(n), where n is the number of bits used
 *  for representing a two's complement integer value (16 in the Hack computer). 
 *  Note: Jack compilers implement multiplication and division
 *  using calls to OS functions in this class.
 *  Template provided by Nand2Tetris, implemented by Aarav Shah.
 */
class Math {
    static int n;             // Number of bits used for representing a two's complement integer
    static Array powersOfTwo; // Stores 2^0, 2^1, 2^2,..., 2^(n-1)

    // Initializes the Math library (specifically the powersOfTwo array, which helps with bit-shifting).
    function void init() {
        var int i;
        let n = 16; // Hack machine uses 16-bit integers
        let powersOfTwo = Array.new(n);
        let powersOfTwo[0] = 1;
        let i = 1;
        while (i < n) {
            let powersOfTwo[i] = powersOfTwo[i-1] + powersOfTwo[i-1];
            let i = i + 1;
        }
        return;
    }

    // Returns the value of the ith bit of x (0 or 1).
    function boolean bit(int x, int i) {
        if ((x & powersOfTwo[i]) = 0) {
            return false;
        }
        return true;    
    }

    /** Returns the product of x and y. 
     *  When a Jack compiler detects the multiplication operator '*'
     *  in an expression, it handles it by invoking this method. 
     *  Thus, in Jack, x * y and Math.multiply(x,y) return the same value. */
    function int multiply(int x, int y) {
        // Use the bit-shifting algorithm from the book to perform multiplication
        var int sum, shiftedX, i;
        let sum = 0;
        let shiftedX = x;

        let i = 0;
        while (i < n) {
            if (Math.bit(y, i) = 1) {
                let sum = sum + shiftedX;
            }
            let shiftedX = shiftedX + shiftedX;
            let i = i + 1;
        }
        return sum;
    }

    /** Returns the integer part of x / y.
     *  When a Jack compiler detects the division operator '/'
     *  an an expression, it handles it by invoking this method.
     *  Thus, x/y and Math.divide(x,y) return the same value. */
    function int divide(int x, int y) {
        // This function deals with negatives, actual computation is done in Math.divideHelper
        var int result;
        var boolean isNegative;
        let isNegative = ((x < 0) & (y > 0)) | ((x > 0) & (y < 0));
        let result = Math.divideHelper(Math.abs(x), Math.abs(y));
        if (isNegative) {
            return -result;
        }
        return result;
    }

    // Complete the actual recursive long division algorithm described in the book
    function int divideHelper(int x, int y) {
        var int q, QY2;
        
        // Recursion base case
        if (y > x) {
            return 0;
        }

        let q = Math.divideHelper(x, y + y);
        let QY2 = (q + q) * y;

        if ((x - (QY2)) < y) {
            return q + q;
        }
        else {
            return q + q + 1;
        }
    }

    /** Returns the integer part of the square root of x (using the binary search algorithm). */
    function int sqrt(int x) {
        var int y, j, potentialAnswer, potentialAnswerSquared;
        let y = 0;
        let j = (n/2) - 1;

        while (j > -1) {
            let potentialAnswer = y + powersOfTwo[j];
            let potentialAnswerSquared = potentialAnswer * potentialAnswer;
            if ((potentialAnswerSquared < x + 1) & (potentialAnswerSquared > -1)) { // overflow check
                let y = potentialAnswer;
            }
            let j = j - 1;
        }
        return y;
    }

    /** Returns the greater value. */
    function int max(int a, int b) {
        if (a > b) {
            return a;
        }
        return b;
    }

    /** Returns the smaller value. */
    function int min(int a, int b) {
        if (a < b) {
            return a;
        }
        return b;
    }

    /** Returns the absolute value of x. */
    function int abs(int x) {
        if (x < 0) {
            return -x;
        }
        return x;
    }
}
